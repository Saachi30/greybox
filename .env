# ---------------------------------------------------------------------------
# LLM configuration
# ---------------------------------------------------------------------------
# Intent parsing (mapping your plain-English requests to a tool call) is
# ALWAYS local - this setting has no effect on it. See docs/RUNBOOK.md.
GREYBOX_OLLAMA_HOST=http://localhost:11434
GREYBOX_INTENT_MODEL=llama3.2:3b
# Report synthesis (writing the executive summary from your findings) can
# be local (default) or hosted. Leave this as "local" unless you've
# deliberately opted into hosted inference - see the "Requirements" section
# of the landing page / docs/RUNBOOK.md for when that's worth it.
GREYBOX_LLM_BACKEND=local
GREYBOX_REPORT_MODEL=llama3.1:8b
# Only used when GREYBOX_LLM_BACKEND=hosted. Any OpenAI-compatible
# /chat/completions endpoint works here - a Greybox-run endpoint (if one
# exists), your own self-hosted vLLM/Ollama with a public URL, or a
# third-party provider you already have a key for. Findings text (not raw
# scan traffic) is the only thing sent here.
GREYBOX_HOSTED_INFERENCE_URL=
GREYBOX_HOSTED_INFERENCE_KEY=
GREYBOX_HOSTED_MODEL=gpt-4o-mini
# ---------------------------------------------------------------------------
# Scanning engine (Kali container) - always local, not configurable to
# remote. See core/tools.py / docs/RUNBOOK.md.
# ---------------------------------------------------------------------------
KALI_CONTAINER_NAME=greybox-kali
# Optional: needed only for the hunter_email tool (email discovery via hunter.io)
HUNTER_API_KEY=
# ---------------------------------------------------------------------------
# Optional, off by default: anonymous install/usage counter.
# No scan data, targets, or findings are ever sent - see core/telemetry.py.
# ---------------------------------------------------------------------------
GREYBOX_TELEMETRY_OPT_IN=false
GREYBOX_TELEMETRY_URL=
HOME=/Users/saachi
